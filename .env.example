# =====================================================================
# Stock & ETF Analyzer – környezeti változók MINTÁJA
# =====================================================================
# Használat:
#   1. Másold le ezt a fájlt .env.local néven (ugyanebbe a mappába).
#   2. A valódi értékeket CSAK a .env.local fájlba írd.
#   3. A .env.local a .gitignore miatt nem kerül verziókezelésbe.
#
# SOHA ne írj valódi kulcsot ebbe a fájlba, és SOHA ne illeszd be chatbe.
# A PHASE 02-höz egyetlen kulcs sem kell.
# =====================================================================

# ---------------------------------------------------------------------
# KLIENS – EXPO_PUBLIC_* változók
# FIGYELEM: ezek plain-textként bekerülnek a lefordított appba,
# bárki kiolvashatja őket. Titkot ide TILOS írni.
# Kiolvasás: src/config/env.ts
# ---------------------------------------------------------------------

# A proxy (saját szerver) alap URL-je, pl. http://192.168.0.10:8081 – PHASE 04-től kell.
EXPO_PUBLIC_API_BASE_URL=

# Adatmód: mock (demóadat, alapértelmezés) | live (valós adat a proxyn át, PHASE 04-től)
EXPO_PUBLIC_DATA_MODE=mock

# ---------------------------------------------------------------------
# SZERVER – csak a proxy (src/server, +api.ts) olvassa, PHASE 04-től.
# Ezek NEM kerülhetnek kliens kódba. A titkos kulcsok helye élesben:
# EAS environment variable, "sensitive" láthatósággal – az EAS Hosting
# "secret" típusú változót NEM tud telepíteni (Expo docs, 2026-11; D-004).
# ---------------------------------------------------------------------

# A proxy adatmódja: live (valós szolgáltatók, alapértelmezés) | mock (KIZÁRÓLAG demóadat,
# nincs keverés). PHASE 04A. A kliens adatmódja (EXPO_PUBLIC_DATA_MODE) ettől független.
PROXY_DATA_MODE=live

# Financial Modeling Prep – TITKOS (PHASE 04B)
FMP_API_KEY=
# Csomagszint: free | starter (D-027, D-051). free: csak US, 250 hívás/nap; a starter NEM igazolt.
FMP_PLAN=free

# EODHD – TITKOS (PHASE 04B)
EODHD_API_KEY=
# Csomagszint: free | eod-all-world (D-051). free: 20 hívás/nap, 1 év ártörténet; a fizetős NEM igazolt.
EODHD_PLAN=free

# OpenFIGI – opcionális, TITKOS (magasabb limit, PHASE 04A)
OPENFIGI_API_KEY=

# SEC EDGAR User-Agent: "AppNév kapcsolattartó@email" – személyes adat, csak .env.local-ba (PHASE 04A)
SEC_USER_AGENT=

# Magyarázat (PHASE 11, D-026, D-078) – CSAK SZERVER (a proxy olvassa, a kliensbe nem kerül)
#   template = LLM kikapcsolva; a kliens ingyenes, szabályalapú összefoglalót ad (alapértelmezés)
#   anthropic = Claude a proxyn át (fizetős, tokenalapú – nem ingyenes és nem korlátlan)
#   mock = demó/teszt válasz, hálózat nélkül
AI_PROVIDER=template
# Kill switch: csak "true" mellett fut LLM. "false" azonnal leállítja (kódváltozás nélkül).
AI_ENABLED=false
# Üresen: claude-opus-5-5 (D-016). A legolcsóbb: claude-haiku-5-5 (a választás a tulajdonosé, DP-04).
AI_MODEL=
# low | medium | high (üresen: low – költség)
AI_EFFORT=
# Költség- és időkorlátok (üresen: 8000 token / hívás, 50 hívás / nap, 60000 ms)
AI_MAX_OUTPUT_TOKENS=
AI_DAILY_LIMIT=
AI_TIMEOUT_MS=
# Csak ha AI_PROVIDER=anthropic – TITKOS (csak .env.local-ba vagy EAS secretbe, chatbe soha)
ANTHROPIC_API_KEY=
